# ═══════════════════════════════════════════════════════
#  Настройки бота Lori
#  1. Скопируйте этот файл и назовите копию  .env
#     (с точкой в начале, без .example)
#  2. Впишите свои значения после знака "="
#     (без кавычек и пробелов)
# ═══════════════════════════════════════════════════════

# ── ОБЯЗАТЕЛЬНО ──────────────────────────────────────
# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Ключ Gemini API из https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── НЕОБЯЗАТЕЛЬНО (можно не трогать) ─────────────────
# Модель Gemini.
# Если появится ошибка "model not found" — замените на другую
# из списка: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Ваш часовой пояс относительно UTC:
#   Москва = 3, Алматы = 5, Берлин = 1
TIMEZONE_OFFSET=3

# Название пояса/города, которое бот называет, когда говорит время
TIMEZONE_NAME=Москва